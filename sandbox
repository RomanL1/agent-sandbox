#!/usr/bin/env bash
# Agentic dev sandbox: a QEMU Linux VM on macOS, driven over ssh.
set -euo pipefail

VERSION=0.2.1

# Follow symlinks (e.g. ~/.local/bin/sandbox from install.sh) to the checkout.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd "$(dirname "$src")" && pwd)"
unset src dir
VM_DIR="${SANDBOX_VM_DIR:-$ROOT/vm}"
CONFIG="$VM_DIR/config"

# Settings chosen at init live in vm/config as KEY=value lines. Variables set
# in the environment win over the file.
CONFIG_KEYS="SANDBOX_CPUS SANDBOX_MEMORY SANDBOX_DISK_SIZE SANDBOX_GIT"
GIT_FROM_ENV="${SANDBOX_GIT+x}"
if [ -f "$CONFIG" ]; then
  while IFS='=' read -r k v; do
    case " $CONFIG_KEYS " in *" $k "*) [ -n "${!k+x}" ] || export "$k=$v" ;; esac
  done < "$CONFIG"
fi
BASE_IMAGE="${SANDBOX_BASE_IMAGE:-$VM_DIR/debian-13-arm64.qcow2}"
IMAGE_URL="https://cloud.debian.org/images/cloud/trixie/latest/debian-13-generic-arm64.qcow2"
NET="${SANDBOX_NET:-user}"         # "none" keeps ssh but blocks all egress
PORTS="${SANDBOX_PORTS:-}"         # e.g. "8080:8080 5173:5173", bound to 127.0.0.1
MEMORY="${SANDBOX_MEMORY:-4G}"
CPUS="${SANDBOX_CPUS:-4}"
DISK_SIZE="${SANDBOX_DISK_SIZE:-40G}"
SSH_PORT="${SANDBOX_SSH_PORT:-2222}"
HOST_HOME="${SANDBOX_HOST_HOME:-$HOME}"
GIT_FWD="${SANDBOX_GIT:-1}"        # 0 keeps your git name and email out of the VM

DISK="$VM_DIR/disk.qcow2"
SEED="$VM_DIR/seed.iso"
KEY="$VM_DIR/id_ed25519"
PIDFILE="$VM_DIR/qemu.pid"
BOOTED_WS="$VM_DIR/workspace.path"  # workspace the running VM was started with

die() { echo "sandbox: $*" >&2; exit 1; }

# Prompts read the terminal directly, so they work under `curl | bash` too.
# Without a terminal, ask returns the default and confirm says no.
have_tty() { { : </dev/tty; } 2>/dev/null; }
ask() {  # ask <question> <default>
  local a=
  if have_tty; then printf '%s [%s]: ' "$1" "$2" >/dev/tty; read -r a </dev/tty || a=; fi
  echo "${a:-$2}"
}
confirm() {  # confirm <question>; Enter means yes
  local a
  have_tty || return 1
  printf '%s [Y/n] ' "$1" >/dev/tty; read -r a </dev/tty || return 1
  case "$a" in ""|y|Y|yes) return 0 ;; *) return 1 ;; esac
}

vm_running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

# Options before the command: -w/--workspace DIR is SANDBOX_WORKSPACE=DIR.
while [ $# -gt 0 ]; do
  case "$1" in
    -w|--workspace) [ $# -ge 2 ] || die "$1 needs a directory"; export SANDBOX_WORKSPACE="$2"; shift 2 ;;
    --workspace=*) export SANDBOX_WORKSPACE="${1#*=}"; shift ;;
    *) break ;;
  esac
done

# Shared host directory. An explicit SANDBOX_WORKSPACE wins; otherwise a running
# VM keeps the workspace it booted with, so later commands need no variable.
if [ -n "${SANDBOX_WORKSPACE:-}" ]; then
  WORKSPACE="$SANDBOX_WORKSPACE"
elif vm_running && [ -s "$BOOTED_WS" ]; then
  WORKSPACE="$(cat "$BOOTED_WS")"
else
  WORKSPACE="$ROOT/workspace"
fi

# Host config dirs each agent keeps its credentials and settings in.
CRED_PATHS=(
  ".claude" ".claude.json"
  ".codex"
  ".config/opencode" ".local/share/opencode"
  ".copilot"
  ".antigravity" ".antigravitycli" ".gemini"
  ".config/gh"
)

# Working directory inside the VM. An explicit SANDBOX_PROJECT wins; otherwise,
# running from inside workspace/ puts the agent in that same project, so
# `cd workspace/myapp && ../../sandbox claude` starts where you already are.
[ -d "$WORKSPACE" ] || die "no such workspace: $WORKSPACE"
ws_real="$(cd "$WORKSPACE" && pwd -P)"
cur_real="$(pwd -P)"
if [ -n "${SANDBOX_PROJECT:-}" ]; then
  [ -d "$ws_real/$SANDBOX_PROJECT" ] || die "no such project: $WORKSPACE/$SANDBOX_PROJECT"
  WORKDIR="/workspace/$SANDBOX_PROJECT"
else
  case "$cur_real" in
    "$ws_real") WORKDIR=/workspace ;;
    "$ws_real"/*) WORKDIR="/workspace/${cur_real#"$ws_real"/}" ;;
    *) WORKDIR=/workspace ;;
  esac
fi

# Forward whichever API keys are set in the calling shell as ssh environment
# (the VM's sshd accepts exactly these), so values never reach a command line.
SSH_ENV=()
for v in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
         OPENAI_API_KEY OPENAI_BASE_URL \
         GITHUB_TOKEN GH_TOKEN \
         OPENCODE_API_KEY GEMINI_API_KEY \
         HTTP_PROXY HTTPS_PROXY NO_PROXY SANDBOX_NO_BYPASS; do
  if [ -n "${!v:-}" ]; then export "${v?}"; SSH_ENV+=(-o "SendEnv=$v"); fi
done
# Git identity, so agent-authored commits are attributed correctly.
gn="$(git config --global user.name 2>/dev/null || true)"
ge="$(git config --global user.email 2>/dev/null || true)"
if [ "$GIT_FWD" = 1 ] && [ -n "$gn" ]; then
  export GIT_AUTHOR_NAME="$gn" GIT_COMMITTER_NAME="$gn"
  SSH_ENV+=(-o SendEnv=GIT_AUTHOR_NAME -o SendEnv=GIT_COMMITTER_NAME)
fi
if [ "$GIT_FWD" = 1 ] && [ -n "$ge" ]; then
  export GIT_AUTHOR_EMAIL="$ge" GIT_COMMITTER_EMAIL="$ge"
  SSH_ENV+=(-o SendEnv=GIT_AUTHOR_EMAIL -o SendEnv=GIT_COMMITTER_EMAIL)
fi

SSH_OPTS=(-p "$SSH_PORT" -i "$KEY" -o IdentitiesOnly=yes -o LogLevel=ERROR
          -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$VM_DIR/known_hosts")

# vssh <user> [ssh args...]: dev runs agents, debian is the sudo-capable admin.
vssh() {
  local user=$1; shift
  ssh "${SSH_OPTS[@]}" ${SSH_ENV[@]+"${SSH_ENV[@]}"} "$user@127.0.0.1" "$@"
}

# A remote command that runs "$@" in WORKDIR through a login shell, which
# loads PATH, ~/.sandbox-env and the agents' permission-bypass wrappers.
remote_cmd() {
  printf 'cd %q && exec bash -lc %q' "$WORKDIR" "$(printf '%q ' "$@")"
}

# Interactive when we have a terminal, plain pipes otherwise (scripts, CI).
# Decided here, not in a $(...) helper, where stdout is always a pipe.
if [ -t 0 ] && [ -t 1 ]; then TTY_FLAG=-t; else TTY_FLAG=-T; fi

# session <ssh args...>: run an ssh session, then put the terminal back. A TUI
# that dies with the connection (VM stopped, ssh dropped, crash) never undoes
# mouse tracking, the alternate screen or bracketed paste, and the terminal
# then types mouse movements into your shell.
session() {
  local rc=0
  ssh "${SSH_OPTS[@]}" "$@" || rc=$?
  if [ -t 1 ]; then
    printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1015l\e[?1004l\e[?2004l\e[<u\e[?1049l\e[?25h'
    stty sane 2>/dev/null || true
  fi
  exit "$rc"
}

firmware() {
  local qemu f
  qemu="$(command -v qemu-system-aarch64)" || die "qemu not found: brew install qemu"
  f="$(dirname "$qemu")/../share/qemu/edk2-aarch64-code.fd"
  [ -f "$f" ] || die "UEFI firmware not found at $f"
  echo "$f"
}

wait_ssh() {
  local i
  for i in $(seq 1 90); do
    vssh dev -o ConnectTimeout=2 -o BatchMode=yes true 2>/dev/null && return 0
    vm_running || die "VM exited during boot; see $VM_DIR/console.log"
    sleep 2
  done
  die "VM did not answer ssh within 3 minutes; see $VM_DIR/console.log"
}

start_vm() {
  if vm_running; then
    [ "$(cat "$BOOTED_WS" 2>/dev/null)" = "$ws_real" ] ||
      die "VM is running with workspace $(cat "$BOOTED_WS" 2>/dev/null); run ./sandbox stop to switch"
    return 0
  fi
  [ -f "$DISK" ] || die "no VM yet: run ./sandbox init"
  local fw; fw="$(firmware)"
  local net="user,id=net0,hostfwd=tcp:127.0.0.1:$SSH_PORT-:22"
  [ "$NET" = none ] && net+=",restrict=on"
  for p in $PORTS; do net+=",hostfwd=tcp:127.0.0.1:${p%%:*}-:${p##*:}"; done
  qemu-system-aarch64 \
    -machine virt -accel hvf -cpu host -smp "$CPUS" -m "$MEMORY" \
    -bios "$fw" \
    -drive "if=virtio,format=qcow2,file=$DISK" \
    -drive "if=virtio,format=raw,readonly=on,file=$SEED" \
    -netdev "$net" -device virtio-net-pci,netdev=net0 \
    -virtfs "local,path=$ws_real,mount_tag=workspace,security_model=none" \
    -display none -serial "file:$VM_DIR/console.log" \
    -daemonize -pidfile "$PIDFILE"
  echo "$ws_real" > "$BOOTED_WS"
  wait_ssh
}

stop_vm() {
  vm_running || return 0
  vssh debian -o ConnectTimeout=5 'sudo systemctl poweroff' 2>/dev/null || true
  local i
  for i in $(seq 1 30); do vm_running || break; sleep 1; done
  vm_running && kill "$(cat "$PIDFILE")"
  rm -f "$PIDFILE" "$BOOTED_WS"
}

# cloud-init NoCloud seed: an admin user with sudo, and an unprivileged agent
# user whose uid matches yours, so it can write the shared workspace and files
# it creates there are owned by you.
make_seed() {
  local d pub
  d="$(mktemp -d)"
  pub="$(cat "$KEY.pub")"
  printf 'instance-id: agent-sandbox\nlocal-hostname: agent-sandbox\n' > "$d/meta-data"
  cat > "$d/user-data" <<EOF
#cloud-config
users:
  - name: debian
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys: ["$pub"]
  - name: dev
    uid: $(id -u)
    shell: /bin/bash
    ssh_authorized_keys: ["$pub"]
mounts:
  - [workspace, /workspace, 9p, "trans=virtio,version=9p2000.L,msize=262144,nofail", "0", "0"]
EOF
  rm -f "$SEED"
  hdiutil makehybrid -quiet -iso -joliet -default-volume-name cidata -o "$SEED" "$d"
  rm -rf "$d"
}

ensure_qemu() {
  command -v qemu-system-aarch64 >/dev/null && return 0
  command -v brew >/dev/null || die "qemu not found and Homebrew missing; install qemu yourself"
  echo "Installing qemu with Homebrew..."
  brew install qemu
}

# Download the Debian base image once and check it against Debian's SHA512SUMS.
ensure_image() {
  [ -f "$BASE_IMAGE" ] && return 0
  local name sums want got
  name="$(basename "$IMAGE_URL")"
  echo "Downloading $name..."
  curl -fL --progress-bar -o "$BASE_IMAGE.part" "$IMAGE_URL"
  sums="$(curl -fsSL "$(dirname "$IMAGE_URL")/SHA512SUMS")"
  want="$(echo "$sums" | awk -v n="$name" '$2 == n {print $1}')"
  got="$(shasum -a 512 "$BASE_IMAGE.part" | awk '{print $1}')"
  [ -n "$want" ] && [ "$want" = "$got" ] || { rm -f "$BASE_IMAGE.part"; die "checksum mismatch for $name"; }
  mv "$BASE_IMAGE.part" "$BASE_IMAGE"
}

# Ask for the VM's resources and git forwarding, and save them to vm/config.
# Runs at init and on `sandbox config`; current values are the defaults.
# Without a terminal the defaults are saved.
configure() {
  local host_cpus host_mem v
  host_cpus="$(sysctl -n hw.ncpu)"
  host_mem="$(( $(sysctl -n hw.memsize) / 1073741824 ))G"
  have_tty && echo "VM settings (Enter keeps the current value; rerun with: sandbox config):"
  while v="$(ask "  CPUs (this Mac has $host_cpus)" "$CPUS")"; do
    [[ "$v" =~ ^[1-9][0-9]*$ ]] && [ "$v" -le "$host_cpus" ] && break
    echo "  enter a number from 1 to $host_cpus"; have_tty || die "invalid SANDBOX_CPUS: $v"
  done; CPUS="$v"
  while v="$(ask "  Memory, e.g. 4G or 8G (this Mac has $host_mem)" "$MEMORY")"; do
    [[ "$v" =~ ^[1-9][0-9]*[MG]$ ]] && break
    echo "  enter a size like 4G or 4096M"; have_tty || die "invalid SANDBOX_MEMORY: $v"
  done; MEMORY="$v"
  if [ -f "$DISK" ]; then
    have_tty && echo "  Disk size: $DISK_SIZE (fixed once the VM exists; destroy + init to change)"
  else
    while v="$(ask "  Disk size limit (grows as used)" "$DISK_SIZE")"; do
      [[ "$v" =~ ^[1-9][0-9]*[MGT]$ ]] && break
      echo "  enter a size like 40G"; have_tty || die "invalid SANDBOX_DISK_SIZE: $v"
    done; DISK_SIZE="$v"
  fi
  if [ -n "$gn$ge" ] && have_tty && [ -z "$GIT_FROM_ENV" ]; then
    if confirm "  Pass your git name and email ($gn <$ge>) into the VM for commits?"; then
      GIT_FWD=1; else GIT_FWD=0; fi
  fi
  mkdir -p "$VM_DIR"
  printf 'SANDBOX_CPUS=%s\nSANDBOX_MEMORY=%s\nSANDBOX_DISK_SIZE=%s\nSANDBOX_GIT=%s\n' \
    "$CPUS" "$MEMORY" "$DISK_SIZE" "$GIT_FWD" > "$CONFIG"
  echo "Saved $CONFIG"
}

# Commands that need a working VM offer to build or finish it first.
ensure_ready() {
  if [ ! -f "$DISK" ]; then
    confirm "No VM yet. Create it now (several minutes)?" || die "no VM yet: run sandbox init"
    "$0" init
  elif [ ! -f "$VM_DIR/provisioned" ]; then
    confirm "The VM was never fully provisioned (init cut short?). Provision it now?" ||
      die "VM is not provisioned; run: sandbox provision"
    "$0" provision
  fi
}

usage() {
  cat <<'USAGE'
usage: ./sandbox [-w|--workspace DIR] <command> [args]

  -w, --workspace DIR     share DIR at /workspace (same as SANDBOX_WORKSPACE)

  init                    install qemu, fetch the image, create and provision the VM
  config                  change CPUs, memory and git forwarding (saved in vm/config)
  provision               rerun provision.sh (after editing it, or if init was cut short)
  start | stop | status   VM lifecycle; agent commands start it on demand
  claude|codex|opencode|copilot|agy [args...]
                          run that agent with its permission bypass enabled
                          (SANDBOX_NO_BYPASS=1 restores the prompts)
  shell                   login shell as the agent user
  root                    root shell in the VM
  run <cmd...>            run one command as the agent user
  import-creds [name...]  copy host agent logins into the VM
  destroy                 delete the VM disk (drops all VM state and logins)
  info                    resolved settings
  version                 print the version

  Run from inside workspace/<project> and the agent starts in that project;
  or set SANDBOX_PROJECT=<name> from anywhere.

env: SANDBOX_WORKSPACE SANDBOX_PROJECT SANDBOX_NET SANDBOX_PORTS SANDBOX_MEMORY
     SANDBOX_CPUS SANDBOX_DISK_SIZE SANDBOX_SSH_PORT SANDBOX_VM_DIR
     SANDBOX_BASE_IMAGE SANDBOX_HOST_HOME SANDBOX_GIT
     init saves CPUs, memory, disk size and SANDBOX_GIT to vm/config
USAGE
}

cmd="${1:-}"; shift || true
case "$cmd" in
  claude|codex|opencode|copilot|agy|shell|root|run|start|import-creds) ensure_ready ;;
esac
case "$cmd" in
  init)
    [ ! -f "$DISK" ] || die "VM already exists at $DISK; ./sandbox destroy to start over"
    mkdir -p "$VM_DIR"
    [ -f "$CONFIG" ] || configure
    ensure_qemu
    ensure_image
    [ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N "" -C agent-sandbox -f "$KEY"
    qemu-img create -q -f qcow2 -F qcow2 -b "$(cd "$(dirname "$BASE_IMAGE")" && pwd)/$(basename "$BASE_IMAGE")" \
      "$DISK" "$DISK_SIZE"
    make_seed
    echo "Booting VM..."
    start_vm
    vssh debian 'sudo cloud-init status --wait' >/dev/null || true
    exec "$0" provision
    ;;

  provision)
    start_vm
    echo "Provisioning (installs toolchain and agents, takes a few minutes)..."
    vssh debian -T 'sudo bash -s' < "$ROOT/provision.sh"
    touch "$VM_DIR/provisioned"   # install.sh reruns provision until this exists
    ;;

  config)
    have_tty || die "config needs a terminal; edit $CONFIG instead"
    configure
    if vm_running; then
      if confirm "Restart the VM now so CPUs and memory apply?"; then stop_vm; start_vm
      else echo "CPUs and memory apply after: sandbox stop"; fi
    fi
    ;;

  start)  start_vm ;;
  stop)   stop_vm ;;
  status) if vm_running; then echo "running (pid $(cat "$PIDFILE"), workspace $(cat "$BOOTED_WS"))"; else echo stopped; fi ;;

  claude|codex|opencode|copilot|agy)
    start_vm
    session ${SSH_ENV[@]+"${SSH_ENV[@]}"} "$TTY_FLAG" dev@127.0.0.1 \
      "$(remote_cmd "$cmd" "$@")"
    ;;

  shell)
    start_vm
    session ${SSH_ENV[@]+"${SSH_ENV[@]}"} -t dev@127.0.0.1 \
      "$(printf 'cd %q && exec bash -l' "$WORKDIR")"
    ;;

  root)
    start_vm
    session -t debian@127.0.0.1 'sudo -i'
    ;;

  run)
    [ $# -gt 0 ] || die "run needs a command"
    start_vm
    session ${SSH_ENV[@]+"${SSH_ENV[@]}"} "$TTY_FLAG" dev@127.0.0.1 \
      "$(remote_cmd "$@")"
    ;;

  import-creds)
    present=()
    for rel in "${CRED_PATHS[@]}"; do
      if [ $# -gt 0 ]; then
        match=0
        for w in "$@"; do [[ "$rel" == *"$w"* ]] && match=1; done
        [ $match -eq 1 ] || continue
      fi
      [ -e "$HOST_HOME/$rel" ] && present+=("$rel")
    done
    [ ${#present[@]} -gt 0 ] || die "no matching agent config found in $HOST_HOME"
    echo "Will copy into the VM: ${present[*]}"
    echo "Code in the VM can then use those logins to act as you."
    echo "Logins macOS keeps in the Keychain (Claude Code, gh) do not come along."
    printf "Continue? [y/N] "
    read -r ans
    [ "$ans" = y ] || { echo "aborted"; exit 1; }
    start_vm
    COPYFILE_DISABLE=1 tar -C "$HOST_HOME" --no-xattrs --exclude '.claude/projects' \
      -cf - "${present[@]}" | vssh dev -T 'tar -xf - -C ~ 2>/dev/null; true'
    echo "imported: ${present[*]}"
    ;;

  destroy)
    printf "Delete the VM disk and every login and file in its home? [y/N] "
    read -r ans
    [ "$ans" = y ] || { echo "aborted"; exit 1; }
    stop_vm
    rm -f "$DISK" "$SEED" "$VM_DIR/known_hosts" "$VM_DIR/console.log" "$VM_DIR/provisioned"
    ;;

  info)
    echo "sandbox:   $VERSION"
    echo "qemu:      $(qemu-system-aarch64 --version 2>/dev/null | head -1 || echo 'not installed')"
    echo "vm:        $(if vm_running; then echo running; else echo stopped; fi)  disk: $DISK"
    echo "base:      $BASE_IMAGE"
    echo "workspace: $WORKSPACE -> /workspace"
    echo "workdir:   $WORKDIR"
    echo "config:    $CONFIG$([ -f "$CONFIG" ] || echo ' (not created yet)')"
    echo "resources: $CPUS cpus, $MEMORY memory, $DISK_SIZE disk"
    echo "git fwd:   $([ "$GIT_FWD" = 1 ] && echo on || echo off)"
    echo "network:   $NET   ssh: 127.0.0.1:$SSH_PORT   ports: ${PORTS:-<none>}"
    echo "env fwd:   ${SSH_ENV[*]:-<none>}" | sed 's/-o SendEnv=//g'
    ;;

  version|--version|-V) echo "agent-sandbox $VERSION" ;;
  ""|-h|--help|help) usage ;;
  *) echo "sandbox: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
